<UserControl x:Class="ZooVillage.Views.Popups.StorePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вкладки -->
        <TabControl Grid.Row="0" x:Name="StoreTabControl" Background="#ECF0F1" BorderBrush="#95A5A6" BorderThickness="0,1,0,0">
            <!-- Вкладка КУПИТЬ -->
            <TabItem Header="🛍️ Купить" Background="#3498DB" Foreground="White" FontSize="16" FontWeight="Bold">
                <Grid Background="#ECF0F1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Таблица товаров для покупки -->
                    <DataGrid Grid.Row="0" x:Name="BuyItemsGrid" AutoGenerateColumns="False"
                              Background="White" GridLinesVisibility="All" BorderBrush="#95A5A6"
                              IsReadOnly="False" SelectionUnit="FullRow" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeRows="False" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="250"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                            <DataGridTextColumn Header="В наличии" Binding="{Binding Available}" Width="100"/>
                            <DataGridTemplateColumn Header="Действие" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Купить" Width="100" Height="35"
                                                Background="#27AE60" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontWeight="Bold"
                                                Click="BuyButton_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Информация о средствах -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,15" HorizontalAlignment="Right">
                        <TextBlock Text="Ваши средства: " FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="BuyMoneyDisplay" Text="0" FontSize="14" FontWeight="Bold"
                                   Foreground="#27AE60" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка ПРОДАТЬ -->
            <TabItem Header="💸 Продать" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold">
                <Grid Background="#ECF0F1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Таблица товаров для продажи -->
                    <DataGrid Grid.Row="0" x:Name="SellItemsGrid" AutoGenerateColumns="False"
                              Background="White" GridLinesVisibility="All" BorderBrush="#95A5A6"
                              IsReadOnly="False" SelectionUnit="FullRow" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserResizeRows="False" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="250"/>
                            <DataGridTextColumn Header="Цена продажи" Binding="{Binding SellPrice}" Width="120"/>
                            <DataGridTextColumn Header="У вас есть" Binding="{Binding OwnCount}" Width="100"/>
                            <DataGridTemplateColumn Header="Действие" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Продать" Width="100" Height="35"
                                                Background="#C0392B" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontWeight="Bold"
                                                Click="SellButton_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Информация о средствах -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,15" HorizontalAlignment="Right">
                        <TextBlock Text="Ваши средства: " FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="SellMoneyDisplay" Text="0" FontSize="14" FontWeight="Bold"
                                   Foreground="#C0392B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
