<UserControl x:Class="ZooVillage.Views.Popups.SettingsPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Button Content="Вернуться в игру" Width="300" Height="50" FontSize="18" Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Resume_Click" Margin="0,0,0,20"/>
        <Button Content="О проекте" Width="300" Height="50" FontSize="18" Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand" Click="About_Click" Margin="0,0,0,20"/>
        <Button Content="Выход в главное меню" Width="300" Height="50" FontSize="18" Background="#C0392B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ExitToMenu_Click"/>
    </StackPanel>
</UserControl>