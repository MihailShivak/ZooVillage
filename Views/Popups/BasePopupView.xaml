<UserControl x:Class="ZooVillage.Views.Popups.BasePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Полупрозрачный фон-затемнение на весь экран -->
    <Grid Background="#80000000" MouseDown="Overlay_Click">

        <!-- Само окно попапа (строго 800x600, по центру) -->
        <Border Background="#ECF0F1" 
                Width="800" Height="600" 
                CornerRadius="15" 
                BorderBrush="#2C3E50" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseDown="Border_MouseDown">
            <!-- Для перетаскивания -->

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <!-- Заголовок -->
                    <RowDefinition Height="*"/>
                    <!-- Контент -->
                </Grid.RowDefinitions>

                <!-- Шапка попапа -->
                <Border Grid.Row="0" Background="#2C3E50" CornerRadius="13,13,0,0">
                    <Grid>
                        <TextBlock x:Name="PopupTitle" Text="Заголовок" 
                                   Foreground="White" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>

                        <!-- Кнопка закрытия -->
                        <Button Content="✕" Width="40" Height="40" FontSize="20"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                Cursor="Hand" Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <!-- Сюда будут подгружаться конкретные окна (Store, Settings и т.д.) -->
                <ContentControl x:Name="PopupContent" Grid.Row="1" Margin="20"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>