<windows:BaseWindow x:Class="ZooVillage.Views.Windows.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="860" Height="620"
        Background="Transparent">

    <Border Background="#ECF0F1" CornerRadius="15"
            BorderBrush="#95A5A6" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="15,15,0,0" Padding="20,12">
                <Grid>
                    <TextBlock Text="🛒 МАГАЗИН" Foreground="#F1C40F" FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" Width="40" Height="40" FontSize="20"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Вкладки -->
            <TabControl Grid.Row="1" Background="#ECF0F1" BorderThickness="0">

                <!-- КУПИТЬ -->
                <TabItem Header="🛍️ Купить" FontSize="16" FontWeight="Bold">
                    <Grid Background="#ECF0F1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" x:Name="BuyItemsGrid" AutoGenerateColumns="False"
                                  Background="White" GridLinesVisibility="All" BorderBrush="#95A5A6"
                                  IsReadOnly="True" SelectionUnit="FullRow" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  CanUserResizeRows="False" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар"      Binding="{Binding ItemName}"  Width="250"/>
                                <DataGridTextColumn Header="Цена"       Binding="{Binding Price}"     Width="100"/>
                                <DataGridTextColumn Header="В наличии"  Binding="{Binding Available}" Width="100"/>
                                <DataGridTemplateColumn Header="Действие" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Купить" Width="100" Height="35"
                                                    Background="#27AE60" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand" FontWeight="Bold"
                                                    Click="BuyButton_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,12"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Ваши средства: " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BuyMoneyDisplay" Text="0" FontSize="14" FontWeight="Bold"
                                       Foreground="#27AE60" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ПРОДАТЬ -->
                <TabItem Header="💸 Продать" FontSize="16" FontWeight="Bold">
                    <Grid Background="#ECF0F1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" x:Name="SellItemsGrid" AutoGenerateColumns="False"
                                  Background="White" GridLinesVisibility="All" BorderBrush="#95A5A6"
                                  IsReadOnly="True" SelectionUnit="FullRow" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  CanUserResizeRows="False" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар"        Binding="{Binding ItemName}"  Width="250"/>
                                <DataGridTextColumn Header="Цена продажи" Binding="{Binding SellPrice}" Width="120"/>
                                <DataGridTextColumn Header="У вас есть"   Binding="{Binding OwnCount}"  Width="100"/>
                                <DataGridTemplateColumn Header="Действие" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Продать" Width="100" Height="35"
                                                    Background="#C0392B" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand" FontWeight="Bold"
                                                    Click="SellButton_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,12"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Ваши средства: " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SellMoneyDisplay" Text="0" FontSize="14" FontWeight="Bold"
                                       Foreground="#C0392B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</windows:BaseWindow>
