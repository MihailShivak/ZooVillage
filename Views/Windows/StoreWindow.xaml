<windows:BaseWindow x:Class="ZooVillage.Views.Windows.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="700" Height="640"
        Background="Transparent">

    <windows:BaseWindow.Resources>
        <Style x:Key="CounterBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7CB342"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#7CB342"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F5F0E8"/>
            <Setter Property="Background" Value="#414833"/>
            <Setter Property="BorderBrush" Value="#2d3326"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </windows:BaseWindow.Resources>

    <Border CornerRadius="15" Background="#656d4a" BorderBrush="#414833" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,8">
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right" Width="36" Height="36"
                        Click="CloseButton_Click">
                    <Image Source="/Assets/Icons/7734272.png" Width="28" Height="28"/>
                </Button>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,0,12,12">

                <!-- КУПИТЬ ЖИВОТНЫХ -->
                <TabItem Header="Купить животных">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BuyAnimalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#CC4a5240" CornerRadius="8" Margin="0,4"
                                                BorderBrush="#414833" BorderThickness="1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding ImagePath}" Width="44" Height="44"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="Bold" Foreground="#F5F0E8"/>
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0} монет'}" FontSize="11" Foreground="#b8c4a8" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="-" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="BuyAnimalMinus_Click"/>
                                                    <TextBlock Text="{Binding Quantity}" FontSize="15" FontWeight="Bold" Width="34" TextAlignment="Center" VerticalAlignment="Center" Foreground="#F5F0E8"/>
                                                    <Button Content="+" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="BuyAnimalPlus_Click"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding Available, StringFormat='{}{0} шт.'}" FontSize="12" Foreground="#b8c4a8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="#CC2d3326" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Итого: " Foreground="White" FontSize="13"/>
                                    <TextBlock x:Name="BuyAnimalTotalText" Text="0 монет" Foreground="#F1C40F" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Content="Купить" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right" Click="BuyAnimalConfirm_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- КУПИТЬ СЫРЬЁ -->
                <TabItem Header="Купить сырьё">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BuyResourceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#CC4a5240" CornerRadius="8" Margin="0,4"
                                                BorderBrush="#414833" BorderThickness="1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding ImagePath}" Width="44" Height="44"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="Bold" Foreground="#F5F0E8"/>
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0} монет'}" FontSize="11" Foreground="#b8c4a8" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="-" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="BuyResourceMinus_Click"/>
                                                    <TextBlock Text="{Binding Quantity}" FontSize="15" FontWeight="Bold" Width="34" TextAlignment="Center" VerticalAlignment="Center" Foreground="#F5F0E8"/>
                                                    <Button Content="+" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="BuyResourcePlus_Click"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding Available, StringFormat='{}{0} шт.'}" FontSize="12" Foreground="#b8c4a8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="#CC2d3326" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Итого: " Foreground="White" FontSize="13"/>
                                    <TextBlock x:Name="BuyResourceTotalText" Text="0 монет" Foreground="#F1C40F" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Content="Купить" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right" Click="BuyResourceConfirm_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ПРОДАТЬ ЖИВОТНЫХ -->
                <TabItem Header="Продать животных">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SellAnimalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#CC4a5240" CornerRadius="8" Margin="0,4"
                                                BorderBrush="#414833" BorderThickness="1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding ImagePath}" Width="44" Height="44"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="Bold" Foreground="#F5F0E8"/>
                                                    <TextBlock Text="{Binding SellPrice, StringFormat='{}{0} монет'}" FontSize="11" Foreground="#b8c4a8" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="-" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="SellAnimalMinus_Click"/>
                                                    <TextBlock Text="{Binding Quantity}" FontSize="15" FontWeight="Bold" Width="34" TextAlignment="Center" VerticalAlignment="Center" Foreground="#F5F0E8"/>
                                                    <Button Content="+" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="SellAnimalPlus_Click"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding OwnCount, StringFormat='{}{0} шт.'}" FontSize="12" Foreground="#b8c4a8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="#CC2d3326" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Итого: " Foreground="White" FontSize="13"/>
                                    <TextBlock x:Name="SellAnimalTotalText" Text="0 монет" Foreground="#F1C40F" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Content="Продать" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right" Click="SellAnimalConfirm_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ПРОДАТЬ СЫРЬЁ -->
                <TabItem Header="Продать сырьё">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SellResourceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#CC4a5240" CornerRadius="8" Margin="0,4"
                                                BorderBrush="#414833" BorderThickness="1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Source="{Binding ImagePath}" Width="44" Height="44"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ItemName}" FontSize="14" FontWeight="Bold" Foreground="#F5F0E8"/>
                                                    <TextBlock Text="{Binding SellPrice, StringFormat='{}{0} монет'}" FontSize="11" Foreground="#b8c4a8" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="-" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="SellResourceMinus_Click"/>
                                                    <TextBlock Text="{Binding Quantity}" FontSize="15" FontWeight="Bold" Width="34" TextAlignment="Center" VerticalAlignment="Center" Foreground="#F5F0E8"/>
                                                    <Button Content="+" Style="{StaticResource CounterBtn}" Tag="{Binding}" Click="SellResourcePlus_Click"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding OwnCount, StringFormat='{}{0} шт.'}" FontSize="12" Foreground="#b8c4a8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="#CC2d3326" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Итого: " Foreground="White" FontSize="13"/>
                                    <TextBlock x:Name="SellResourceTotalText" Text="0 монет" Foreground="#F1C40F" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Content="Продать" Style="{StaticResource ActionBtn}" HorizontalAlignment="Right" Click="SellResourceConfirm_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</windows:BaseWindow>
