<windows:BaseWindow x:Class="ZooVillage.Views.Windows.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="700" Height="580"
        Background="Transparent">

    <Border CornerRadius="15" Background="#656d4a" BorderBrush="#414833" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка: заголовок + кнопка закрытия -->
            <Grid Grid.Row="0" Margin="16,12">
                <TextBlock Text="АМБАР" FontSize="20" FontWeight="Bold" Foreground="#F5F0E8" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right" Width="36" Height="36"
                        Click="CloseButton_Click">
                    <Image Source="/Assets/Icons/7734272.png" Width="28" Height="28"/>
                </Button>
            </Grid>

            <!-- Список ресурсов -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка таблицы -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" FontWeight="Bold" FontSize="12" Foreground="#b8c4a8"/>
                    <TextBlock Grid.Column="1" Text="Ресурс" FontWeight="Bold" FontSize="12" Foreground="#b8c4a8"/>
                    <TextBlock Grid.Column="2" Text="Кол-во" FontWeight="Bold" FontSize="12" Foreground="#b8c4a8" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Список товаров -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResourceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#CC4a5240" CornerRadius="8" Margin="0,4"
                                        BorderBrush="#414833" BorderThickness="1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка -->
                                        <Image Grid.Column="0"
                                               Source="{Binding ImagePath}"
                                               Width="44" Height="44"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               VerticalAlignment="Center"/>

                                        <!-- Название -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#F5F0E8"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>

                                        <!-- Количество -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Quantity, StringFormat='{}{0}'}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#b8c4a8"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</windows:BaseWindow>
