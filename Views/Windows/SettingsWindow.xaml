<windows:BaseWindow x:Class="ZooVillage.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="400" Height="320"
        Background="Transparent">

    <Border CornerRadius="15" Background="#2d3326" BorderBrush="#2d3326" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка закрытия -->

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2d3326" Height="165">
                <Button Content="Вернуться в игру"
                        Style="{StaticResource GhostButton}"
                        Width="300" Height="46" FontSize="13"
                        Margin="0,0,0,12" Click="Resume_Click"/>

                <Button Content="О проекте"
                        Style="{StaticResource GhostButton}"
                        Width="300" Height="46" FontSize="13"
                        Margin="0,0,0,12" Click="About_Click"/>

                <Button Content="Выход в главное меню"
                        Style="{StaticResource GhostButton}"
                        Width="300" Height="46" FontSize="13"
                        Click="ExitToMenu_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</windows:BaseWindow>
