<windows:BaseWindow x:Class="ZooVillage.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="400" Height="320"
        Background="Transparent">

    <Border CornerRadius="15" Background="#656d4a" BorderBrush="#414833" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка закрытия -->
            <Grid Grid.Row="0" Margin="10,8">
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right" Width="36" Height="36"
                        Click="Close_Click">
                    <Image Source="/Assets/Icons/7734272.png" Width="28" Height="28"/>
                </Button>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,20" Background="#2d3326">
                <Button Content="Вернуться в игру"
                        Style="{StaticResource GhostButton}"
                        Width="300" Height="46" FontSize="13"
                        Margin="0,0,0,12" Click="Resume_Click"/>

                <Button Content="О проекте"
                        Style="{StaticResource GhostButton}"
                        Width="300" Height="46" FontSize="13"
                        Margin="0,0,0,12" Click="About_Click"/>

                <Button Content="Выход в главное меню"
                        Style="{StaticResource GhostButton}"
                        Width="300" Height="46" FontSize="13"
                        Click="ExitToMenu_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</windows:BaseWindow>
