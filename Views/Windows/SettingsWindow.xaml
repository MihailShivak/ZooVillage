<windows:BaseWindow x:Class="ZooVillage.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="400" Height="340"
        Background="Transparent">

    <Border Background="#2C3E50" CornerRadius="15"
            BorderBrush="#34495E" BorderThickness="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="⚙️ НАСТРОЙКИ" Foreground="#F1C40F" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button x:Name="ResumeButton" Content="Вернуться в игру"
                    Width="300" Height="50" FontSize="18"
                    Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,15" Click="Resume_Click"/>

            <Button x:Name="AboutButton" Content="О проекте"
                    Width="300" Height="50" FontSize="18"
                    Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,15" Click="About_Click"/>

            <Button x:Name="ExitButton" Content="Выход в главное меню"
                    Width="300" Height="50" FontSize="18"
                    Background="#C0392B" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="ExitToMenu_Click"/>
        </StackPanel>
    </Border>
</windows:BaseWindow>
