<windows:BaseWindow x:Class="ZooVillage.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:ZooVillage.Views.Windows"
        Width="400" Height="340"
        Background="Transparent">

    <Border CornerRadius="15" BorderBrush="#8B6343" BorderThickness="1">
        <Border.Background>
            <ImageBrush ImageSource="/Assets/Images/back.png" Stretch="UniformToFill"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопка закрытия -->
            <Grid Grid.Row="0" Margin="10,8">
                <Button Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" Width="36" Height="36"
                        Cursor="Hand" Click="Close_Click">
                    <Image Source="/Assets/Icons/7734272.png" Width="28" Height="28"/>
                </Button>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,20">
                <Button Content="Вернуться в игру"
                        Width="300" Height="50" FontSize="17"
                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,0,14" Click="Resume_Click"/>

                <Button Content="О проекте"
                        Width="300" Height="50" FontSize="17"
                        Background="#2980B9" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,0,14" Click="About_Click"/>

                <Button Content="Выход в главное меню"
                        Width="300" Height="50" FontSize="17"
                        Background="#C0392B" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="ExitToMenu_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</windows:BaseWindow>
