<UserControl x:Class="ZooVillage.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Фоновое изображение с блюром -->
        <Image Source="/Assets/Images/game_back.png" Stretch="Fill">
            <Image.Effect>
                <BlurEffect Radius="12"/>
            </Image.Effect>
        </Image>

        <!-- Затемняющий оверлей -->
        <Rectangle Fill="#000000" Opacity="0.20"/>

        <!-- Контент -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- Логотип -->
            <Image Grid.Row="0"
                   Source="/Assets/Images/zoovillage.png"
                   Stretch="Uniform"
                   MaxHeight="220"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,30,0,0"/>

            <!-- Кнопки меню -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,40,0,0">

                <Button Content="ИГРАТЬ"
                        Style="{StaticResource GhostButton}"
                        Width="280" Height="65" FontSize="26" FontWeight="Bold"
                        Margin="0,0,0,20" Click="PlayButton_Click"/>

                <Button Content="О ПРОЕКТЕ"
                        Style="{StaticResource GhostButton}"
                        Width="280" Height="65" FontSize="26" FontWeight="Bold"
                        Margin="0,0,0,20" Click="AboutButton_Click"/>

                <Button Content="ВЫЙТИ"
                        Style="{StaticResource GhostButton}"
                        Width="280" Height="65" FontSize="26" FontWeight="Bold"
                        Click="ExitButton_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
