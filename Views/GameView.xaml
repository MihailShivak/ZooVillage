<UserControl x:Class="ZooVillage.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZooVillage.Views.Converters">

    <Grid>
        <Grid.Resources>
            <local:AnimalToImageConverter x:Key="AnimalToImageConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фон (растянут на всю сетку) -->
        <Image Source="/Assets/Images/game_back.png" Stretch="Fill"
               Grid.RowSpan="3"/>

        <!-- Верхняя панель: баланс -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,30,0">
            <Image Source="/Assets/Icons/coin.png" Width="32" Height="32"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Budget, StringFormat='{}{0}'}" FontSize="26" FontWeight="ExtraBold"
                       Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Игровая зона с животными -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="600" Height="600" Background="Transparent" CornerRadius="15"
                    BorderBrush="Transparent" BorderThickness="2" Opacity="0.3"/>

            <ItemsControl ItemsSource="{Binding AnimalVisuals}" IsHitTestVisible="False" Width="600" Height="600">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Transparent" Width="600" Height="600"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Основная иконка животного -->
                            <Image Source="{Binding Animal, Converter={StaticResource AnimalToImageConverter}}"
                                   Width="80" Height="80"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                            <!-- Иконка сердца при размножении -->
                            <Image Source="/Assets/Icons/love.png"
                                   Width="32" Height="32"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="4"
                                   Visibility="{Binding IsBreeding, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Grid>

        <!-- Нижняя панель с кнопками -->
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0,0,0,40"
                Background="#656d4a"
                BorderBrush="#414833"
                BorderThickness="1"
                Opacity="1"
                CornerRadius="18"
                Padding="10px" 
                Width="820px"
                >
            <StackPanel Orientation="Horizontal">

                <Button Width="64" Height="64" Opacity="1" Style="{StaticResource IconButton}"
                        Cursor="Hand" Margin="294,0,20,0" Click="StorageButton_Click">
                    <Image Source="/Assets/Icons/home-button.png" Width="44" Height="44"/>
                </Button>

                <Button Width="64" Height="64" Opacity="1" Style="{StaticResource IconButton}"
                        Cursor="Hand" Margin="0,0,20,0" Click="StoreButton_Click">
                    <Image Source="/Assets/Icons/basket_409126.png" Width="44" Height="44"/>
                </Button>

                <Button Width="64" Height="64" Opacity="1" Style="{StaticResource IconButton}"
                        Cursor="Hand" Click="SettingsButton_Click">
                    <Image Source="/Assets/Icons/13147603.png" Width="44" Height="44"/>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
