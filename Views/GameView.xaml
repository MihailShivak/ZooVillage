<UserControl x:Class="ZooVillage.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Fill="#27AE60" Grid.RowSpan="3"/>

        <Grid Grid.Row="0" Margin="30, 20, 30, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="NotificationPanel" Grid.Column="1" 
                    Background="#E74C3C" CornerRadius="8" Padding="25,12">
                <TextBlock Text="⚠️ Недостаточно средств для покупки!" 
                           Foreground="White" FontWeight="Bold" FontSize="18"/>
            </Border>

            <Border Grid.Column="2" 
                    Background="#F1C40F" CornerRadius="12" Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰 " FontSize="28" VerticalAlignment="Center"/>
                    <TextBlock Text="1 500" FontSize="28" FontWeight="ExtraBold" 
                               Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Border Background="#2ECC71" Margin="40" CornerRadius="15" BorderBrush="White" BorderThickness="2" Opacity="0.3">
                <TextBlock Text="[Здесь будет сетка фермы и животные]" 
                           Foreground="White" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,50">

            <Button Content="📦 АМБАР" Width="180" Height="60" FontSize="20" FontWeight="Bold" 
                    Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Margin="0,0,30,0" Click="StorageButton_Click"/>

            <Button Content="🛒 МАГАЗИН" Width="180" Height="60" FontSize="20" FontWeight="Bold" 
                    Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Margin="0,0,30,0" Click="StoreButton_Click"/>

            <Button Content="⚙️ НАСТРОЙКИ" Width="180" Height="60" FontSize="20" FontWeight="Bold" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="SettingsButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>