<Application x:Class="ZooVillage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZooVillage.Views.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <FontFamily x:Key="PixelFont">/Assets/Fonts/PressStart2P-Regular.ttf#Press Start 2P</FontFamily>

        <!-- BoolToVisibility конвертер -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Базовый стиль для ВСЕХ кнопок: убирает WPF chrome и hover-эффект -->
        <Style TargetType="Button">
            <Setter Property="FontFamily"      Value="{StaticResource PixelFont}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка без фона (меню, навигация) -->
        <Style x:Key="GhostButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
        </Style>

        <!-- Иконочная кнопка (только картинка, без всего) -->
        <Style x:Key="IconButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="Transparent"/>
        </Style>

        <!-- TabItem без WPF chrome -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily"   Value="{StaticResource PixelFont}"/>
            <Setter Property="Foreground"   Value="#b8c4a8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" CornerRadius="8,8,0,0"
                                Background="#4a5240" BorderBrush="#414833" BorderThickness="1,1,1,0"
                                Margin="2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d3326"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#414833"/>
                                <Setter Property="Foreground" Value="#F5F0E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
